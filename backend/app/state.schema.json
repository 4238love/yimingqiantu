{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "YiMingQianTu Player Session State",
  "type": "object",
  "additionalProperties": true,
  "definitions": {
    "lifeState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "健康": { "type": "integer", "minimum": 0, "maximum": 100 },
        "心智": { "type": "integer", "minimum": 0, "maximum": 100 },
        "情绪": { "type": "integer", "minimum": 0, "maximum": 100 },
        "学识": { "type": "integer", "minimum": 0, "maximum": 100 },
        "事业": { "type": "integer", "minimum": 0, "maximum": 100 },
        "财富": { "type": "integer", "minimum": 0, "maximum": 100 },
        "家庭": { "type": "integer", "minimum": 0, "maximum": 100 },
        "感情": { "type": "integer", "minimum": 0, "maximum": 100 },
        "社交": { "type": "integer", "minimum": 0, "maximum": 100 },
        "名望": { "type": "integer", "minimum": 0, "maximum": 100 },
        "福德": { "type": "integer", "minimum": 0, "maximum": 100 },
        "压力": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "pillarCycle": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "age_start": { "type": "integer" },
        "age_end": { "type": "integer" },
        "age_start_months": { "type": "integer" },
        "age_end_months": { "type": "integer" },
        "age_start_label": { "type": "string" },
        "age_end_label": { "type": "string" },
        "age": { "type": "integer" },
        "year": { "type": "integer" },
        "month": { "type": "integer" },
        "month_name": { "type": "string" },
        "half": { "type": "integer" },
        "half_label": { "type": "string" },
        "pillar": { "type": "string" },
        "theme": { "type": "array", "items": { "type": "string" } },
        "events": { "type": "array", "items": { "type": "string" } },
        "risk": { "type": "array", "items": { "type": "string" } },
        "opportunity": { "type": "array", "items": { "type": "string" } },
        "modifiers": { "type": "object" }
      }
    },
    "baziChart": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "year_pillar": { "type": "string" },
        "month_pillar": { "type": "string" },
        "day_pillar": { "type": "string" },
        "hour_pillar": { "type": ["string", "null"] },
        "day_master": { "type": "string" },
        "day_strength": { "type": "string" },
        "five_elements": {
          "type": "object",
          "properties": {
            "wood": { "type": "integer" },
            "fire": { "type": "integer" },
            "earth": { "type": "integer" },
            "metal": { "type": "integer" },
            "water": { "type": "integer" }
          }
        },
        "useful_elements": { "type": "array", "items": { "type": "string" } },
        "unfavorable_elements": { "type": "array", "items": { "type": "string" } },
        "ten_gods": { "type": "object" },
        "mode": { "type": "string" },
        "luck_start_label": { "type": "string" },
        "luck_start_months": { "type": "integer" }
      }
    },
    "baziAnalysis": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "five_element_balance": { "type": "object" },
        "day_master_status": { "type": "string" },
        "useful_elements": { "type": "array", "items": { "type": "string" } },
        "unfavorable_elements": { "type": "array", "items": { "type": "string" } },
        "ten_god_focus": { "type": "array", "items": { "type": "string" } },
        "luck_cycle_themes": { "type": "array", "items": { "type": "string" } },
        "life_topics": { "type": "array", "items": { "type": "string" } },
        "suitable_directions": { "type": "array", "items": { "type": "string" } },
        "high_risk_fields": { "type": "array", "items": { "type": "string" } },
        "chart_tags": { "type": "array", "items": { "type": "string" } },
        "source": { "type": "string" }
      }
    }
  },
  "properties": {
    "player_id": { "type": "string" },
    "session_date": { "type": "string" },
    "phase": { "type": "string", "enum": ["birth_input", "chart_ready", "prelude_ready", "life_simulation", "ending"] },
    "birth_info": { "type": "object" },
    "bazi_chart": { "$ref": "#/definitions/baziChart" },
    "bazi_analysis": { "$ref": "#/definitions/baziAnalysis" },
    "chart_tags": { "type": "array", "items": { "type": "string" } },
    "life_topics": { "type": "array", "items": { "type": "string" } },
    "suitable_directions": { "type": "array", "items": { "type": "string" } },
    "high_risk_fields": { "type": "array", "items": { "type": "string" } },
    "luck_cycles": { "type": "array", "items": { "$ref": "#/definitions/pillarCycle" } },
    "annual_cycles": { "type": "array", "items": { "$ref": "#/definitions/pillarCycle" } },
    "monthly_cycles": { "type": "array", "items": { "$ref": "#/definitions/pillarCycle" } },
    "start_age": { "type": ["integer", "null"], "minimum": 6, "maximum": 60 },
    "current_age": { "type": ["integer", "null"], "minimum": 0 },
    "current_year": { "type": ["integer", "null"] },
    "current_half": { "type": "integer", "enum": [1, 2] },
    "current_half_label": { "type": "string" },
    "current_stage": { "type": "object" },
    "current_luck_cycle": { "type": "object" },
    "current_annual_cycle": { "type": "object" },
    "current_monthly_cycles": { "type": "array", "items": { "$ref": "#/definitions/pillarCycle" } },
    "life_state": {
      "anyOf": [
        { "$ref": "#/definitions/lifeState" },
        { "type": "object", "maxProperties": 0 }
      ]
    },
    "life_systems": { "type": "object" },
    "life_goals": { "type": "array" },
    "active_life_goal_id": { "type": "string" },
    "goal_progress": { "type": "object" },
    "achievements": { "type": "array" },
    "latest_achievements": { "type": "array" },
    "milestones": { "type": "array" },
    "personality": { "type": "array", "items": { "type": "string" } },
    "relationships": { "type": "array" },
    "major_events": { "type": "array", "items": { "type": "string" } },
    "half_year_summaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "age": { "type": "integer" },
          "year": { "type": ["integer", "null"] },
          "half": { "type": "integer" },
          "half_label": { "type": "string" },
          "summary": { "type": "string" },
          "state_effect": { "type": "object" },
          "focuses": { "type": "array", "items": { "type": "string" } },
          "main_focus": { "type": "string" },
          "roll_event": { "type": "object" },
          "roll_modifiers": { "type": "object" },
          "state_before": { "type": "object" },
          "state_after": { "type": "object" },
          "life_systems_before": { "type": "object" },
          "life_systems_after": { "type": "object" },
          "relationships_before": { "type": "array" },
          "relationships_after": { "type": "array" },
          "goal_progress_before": { "type": "object" },
          "goal_progress_after": { "type": "object" },
          "new_achievements": { "type": "array" },
          "milestone": { "type": "object" },
          "luck_cycle": { "type": "object" },
          "annual_cycle": { "type": "object" },
          "monthly_cycles": { "type": "array", "items": { "$ref": "#/definitions/pillarCycle" } },
          "stage_label": { "type": "string" },
          "stage_event": { "type": "object" }
        },
        "required": ["age", "half", "summary", "state_effect"]
      }
    },
    "annual_summaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "age": { "type": "integer" },
          "year": { "type": ["integer", "null"] },
          "half": { "type": "integer" },
          "half_label": { "type": "string" },
          "summary": { "type": "string" },
          "state_effect": { "type": "object" },
          "focuses": { "type": "array", "items": { "type": "string" } },
          "main_focus": { "type": "string" },
          "roll_event": { "type": "object" },
          "roll_modifiers": { "type": "object" },
          "state_before": { "type": "object" },
          "state_after": { "type": "object" },
          "life_systems_before": { "type": "object" },
          "life_systems_after": { "type": "object" },
          "relationships_before": { "type": "array" },
          "relationships_after": { "type": "array" },
          "goal_progress_before": { "type": "object" },
          "goal_progress_after": { "type": "object" },
          "new_achievements": { "type": "array" },
          "milestone": { "type": "object" },
          "luck_cycle": { "type": "object" },
          "annual_cycle": { "type": "object" },
          "monthly_cycles": { "type": "array", "items": { "$ref": "#/definitions/pillarCycle" } },
          "stage_label": { "type": "string" },
          "stage_event": { "type": "object" },
          "gm_narrative": { "type": "string" },
          "gm_scene_title": { "type": "string" },
          "gm_memory_tags": { "type": "array", "items": { "type": "string" } },
          "gm_state_update_suggestion": { "type": "object" },
          "gm_source": { "type": "string" },
          "long_term_impact": { "type": "string" },
          "memory_tags": { "type": "array", "items": { "type": "string" } },
          "source": { "type": "string" }
        },
        "required": ["age", "summary", "state_effect"]
      }
    },
    "display_history": { "type": "array", "items": { "type": "string" } },
    "internal_history": { "type": "array" },
    "roll_event": { "type": ["object", "null"] },
    "is_processing": { "type": "boolean" },
    "is_finished": { "type": "boolean" },
    "ending_reason": { "type": "string" },
    "ending": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "title": { "type": "string" },
            "reason": { "type": "string" },
            "summary": { "type": "string" },
            "final_state": { "type": "object" },
            "dimensions": { "type": "object" },
            "achievements": { "type": "array", "items": { "type": "string" } },
            "regrets": { "type": "array", "items": { "type": "string" } },
            "key_turning_points": { "type": "array", "items": { "type": "string" } },
            "life_systems": { "type": "object" },
            "relationships": { "type": "array" },
            "life_goal": { "type": "object" },
            "life_goal_achieved": { "type": "boolean" },
            "achievements_unlocked": { "type": "array" },
            "milestones": { "type": "array" }
          }
        }
      ]
    },
    "action_options": { "type": "array", "items": { "type": "string" } },
    "current_life": { "type": ["object", "null"] }
  },
  "required": [
    "player_id",
    "session_date",
    "phase",
    "birth_info",
    "bazi_chart",
    "bazi_analysis",
    "chart_tags",
    "life_topics",
    "suitable_directions",
    "high_risk_fields",
    "luck_cycles",
    "annual_cycles",
    "monthly_cycles",
    "start_age",
    "current_age",
    "current_year",
    "current_half",
    "current_half_label",
    "current_stage",
    "current_luck_cycle",
    "current_annual_cycle",
    "current_monthly_cycles",
    "life_state",
    "life_systems",
    "life_goals",
    "active_life_goal_id",
    "goal_progress",
    "achievements",
    "latest_achievements",
    "milestones",
    "personality",
    "relationships",
    "major_events",
    "half_year_summaries",
    "annual_summaries",
    "display_history",
    "internal_history",
    "roll_event",
    "is_processing",
    "is_finished",
    "ending_reason",
    "ending",
    "action_options",
    "current_life"
  ]
}
